# BotFather'dan olingan token
BOT_TOKEN=123456:ABC-your-token

# Bosh admin(lar)ning Telegram ID si, vergul bilan ajratiladi
ADMIN_IDS=123456789

# Vaqt zonasi
TZ_NAME=Asia/Tashkent

# Akkaunt ulash (3-bosqich) uchun: https://my.telegram.org > API development tools
# Bitta juft hamma hostlar uchun ishlaydi. Bo'sh qoldirsangiz akkaunt ulash o'chiq bo'ladi.
API_ID=
API_HASH=

# Sessiyalarni shifrlash kaliti (ixtiyoriy). Bo'sh bo'lsa .session_key fayli avtomatik yaratiladi.
# Kalit: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SESSION_KEY=
